# Variables de entorno del servidor de producción. Se copia como .env en
# /opt/karaoke/final_backend_project y se completan los valores vacíos.

# Base de datos (instalar.sh crea el usuario y la base con estos datos)
DB_USER=karaoke
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=media_db

# Seguridad: clave larga y aleatoria (openssl rand -hex 32)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Origen del cliente web (Azure Static Web Apps), separado por comas
FRONTEND_ORIGIN=

# Transcripción en CPU (2 vCPU)
WHISPERX_DEVICE=cpu
WHISPERX_MODEL=large-v3-turbo
WHISPERX_BATCH=8
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_LANGUAGE=es
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2

# Firebase Cloud Messaging (cuenta de servicio del proyecto)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
